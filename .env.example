# Copier ce fichier vers .env et choisir une clé locale pour APP_SECRET.
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-me-for-local-development

# Seul Nginx publie un port sur la machine hôte.
HTTP_PORT=8080
DEFAULT_URI=http://127.0.0.1:${HTTP_PORT}

# Quotas des conteneurs (ils ne limitent pas les étapes de build).
FRONTEND_CPUS=1.5
FRONTEND_MEMORY=1024M
BACKEND_CPUS=1.5
BACKEND_MEMORY=512M
NGINX_CPUS=0.25
NGINX_MEMORY=64M

# Configuration de PHP-FPM et de PHP.
PHP_FPM_MAX_CHILDREN=2
PHP_MEMORY_LIMIT=128M

# Configuration des workers Nginx.
NGINX_WORKER_PROCESSES=1
NGINX_WORKER_CONNECTIONS=1024

# Quotas du contrôle statique du code.
LINT_CPUS=0.5
LINT_MEMORY=512M

# Quotas des tests Symfony.
TEST_CPUS=0.5
TEST_MEMORY=256M
