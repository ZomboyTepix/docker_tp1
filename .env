# ─────────────────────────────────────────────────────────────────
# .env – Variables d'environnement pour docker-compose
# ⚠ Ce fichier est INTERDIT en production : utiliser des secrets Docker
# ⚠ Ne jamais committer ce fichier (.gitignore doit l'exclure)
# ─────────────────────────────────────────────────────────────────

# ── Symfony ────────────────────────────────────────────────────────
APP_ENV=dev
APP_SECRET=a7f3c9d2e4b6801e5f2a4c8d0b3e6f91  # Générer avec : openssl rand -hex 32

# ── Base de données ────────────────────────────────────────────────
DB_NAME=studyup
DB_USER=studyup_user
DB_PASSWORD=studyup_pass_dev
DB_ROOT_PASSWORD=root_secret_dev

# ── PHP-FPM ────────────────────────────────────────────────────────
PHP_FPM_MAX_CHILDREN=15
PHP_MEMORY_LIMIT=256M

# ── Nginx ──────────────────────────────────────────────────────────
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024
