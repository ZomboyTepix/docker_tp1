# backend/.env – Configuration Symfony (lu par symfony/dotenv)
# ⚠ Les valeurs ici sont des DÉFAUTS pour le dev local sans Docker.
# En Docker, les variables injectées via docker-compose écrasent ces valeurs.
# Ne jamais mettre de secrets réels dans ce fichier (commité sur Git).

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=default_secret_override_via_docker
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format : driver://user:password@host:port/dbname
# Les variables DB_* sont injectées par Docker Compose au runtime
DATABASE_URL="mysql://${DB_USER:-studyup_user}:${DB_PASSWORD:-studyup_pass_dev}@${DB_HOST:-127.0.0.1}:3306/${DB_NAME:-studyup}?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/routing ###
# URL de base pour la génération d'URLs en contexte CLI
DEFAULT_URI=http://localhost
###< symfony/routing ###
